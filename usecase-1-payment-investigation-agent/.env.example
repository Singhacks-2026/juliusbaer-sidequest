# Copy this file to .env only if you do not already have one.
# Uncomment ONE provider block and supply its key and model name.
# Environment variables override .env. Never commit API keys.

LLM_PROVIDER=auto
# auto selects the only configured provider; otherwise use openai/anthropic/azure.
# OpenAI-compatible services, including Gemini, use LLM_PROVIDER=openai.

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=your-model-name
# LLM_API=responses

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=your-model-name

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=your-supported-api-version
# LLM_API=chat_completions

# --- Generic OpenAI-compatible endpoint ---
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# LLM_API=chat_completions
# For a local service without authentication, use a nonempty dummy API key.

# --- Gemini through its OpenAI-compatible endpoint ---
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=your-gemini-model-name
# LLM_API=chat_completions

# Automatic API choice: custom OPENAI_BASE_URL -> chat_completions;
# otherwise OpenAI -> responses. Set LLM_API explicitly to override this.
# Some compatible services/models use max_completion_tokens instead of max_tokens.
# LLM_CHAT_TOKEN_FIELD=max_tokens

# Bounded execution and local tool traces:
# LLM_MAX_ROUNDS=14
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TIMEOUT_SECONDS=45
# LLM_MIN_REQUEST_INTERVAL_SECONDS=0
# Set a longer interval for a provider with a low requests-per-minute limit.
# LLM_TRACE_DIR=artifacts/traces
# Set LLM_TRACE_DIR= (empty) to disable local traces.

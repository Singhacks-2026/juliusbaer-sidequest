# Copy this file to .env and fill in your key.
#
# This submission uses OpenAI with tool calling. Only OPENAI_API_KEY is
# required; the model defaults to gpt-4o.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional: point at any OpenAI-compatible endpoint (Azure gateway, a local
# server, or a free-tier proxy) without changing code.
# OPENAI_BASE_URL=https://api.openai.com/v1

# If no key is set, main.py still completes and answers all ten questions from
# the deterministic tools and RAG evidence alone, without the LLM narrative.
